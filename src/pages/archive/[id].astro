---
import { getCollection, render } from "astro:content";
import ReviewLayout from "../../layouts/ReviewLayout.astro";

export async function getStaticPaths() {
    const reviews = await getCollection(
        "reviews",
        ({ data }) => data.status === "published",
    );

    return reviews.map((review) => ({
        params: { id: review.id },
        props: { review },
    }));
}

const { review } = Astro.props;
const { Content } = await render(review);
---

<ReviewLayout
    artist={review.data.artist}
    title={review.data.title}
    score={review.data.score}
    cover={review.data.cover}
    genres={review.data.genres}
    standoutTracks={review.data.standout_tracks}
>
    <Content />
</ReviewLayout>
